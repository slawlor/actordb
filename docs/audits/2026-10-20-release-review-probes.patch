+        use futures::FutureExt;
+        let state = FragmentState::new(HashMap::new(), None, 100, Duration::from_secs(60));
+        let guard = state.cache.write().await;
+        let mut value = VersionedValue::new(vec![1], 100, "writer".into());
+        value.expires_at_ms = Some(now_ms() + 50);
+        let op = ReplicatedOp { key: "key".into(), value, seq: 0, boot_id: 0 };
+        let mut applying = Box::pin(state.apply(&op));
+        assert!(applying.as_mut().now_or_never().is_none());
+        std::thread::sleep(Duration::from_millis(75));
+        assert!(op.value.is_expired(now_ms()));
+        drop(guard);
