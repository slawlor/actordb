diff --git a/actordb/tests/release_audit_probes.rs b/actordb/tests/release_audit_probes.rs
new file mode 100644
--- /dev/null
+++ b/actordb/tests/release_audit_probes.rs
@@ -0,0 +1,44 @@
+use std::collections::HashMap;
+use std::time::Duration;
+use actordb::actor::{now_ms, ApplyOutcome, FragmentState, HlcClock, ReplicatedOp, VersionedValue};
+use actordb::node::{Node, NodeConfig};
+use actordb::query::{QueryExecutionError, QueryOptions};
+
+#[test]
+fn release_audit_clock_rejects_high_throughput_local_versions() {
+    let mut producer = HlcClock::new().with_max_skew(300_000);
+    let mut receiver = HlcClock::new().with_max_skew(300_000);
+    for _ in 0..1_000_000 { producer.tick(); }
+    let version = producer.tick();
+    let drift = version.saturating_sub(now_ms());
+    println!("one million local events create {drift} milliseconds of future drift");
+    assert!(drift > 300_000);
+    assert!(receiver.observe(version).is_err());
+    assert!(receiver.seed_persisted(version).is_err());
+}
+
+#[tokio::test]
+async fn release_audit_exact_key_exhausts_scan_budget() {
+    let node = Node::start("audit-query".into(), "127.0.0.1:0".parse().unwrap(), NodeConfig::default()).await.unwrap();
+    for i in 0..100 { node.put(format!("key:{i:03}"), vec![1]).await.unwrap(); }
+    assert!(node.get("key:099".into()).await.unwrap().is_some());
+    let plan = actordb_query::parse("SELECT key FROM kv WHERE key = 'key:099'").unwrap();
+    let result = node.query_plan_with_options(&plan, QueryOptions { max_scanned_rows: 10, ..Default::default() }).await;
+    println!("exact key query: {result:?}");
+    assert!(matches!(result, Err(QueryExecutionError::BudgetExceeded(_))));
+    node.shutdown().await.unwrap();
+}
+
+#[tokio::test]
+async fn release_audit_conflicting_same_version_does_not_converge() {
+    let a = FragmentState::new(HashMap::new(), None, 100, Duration::from_secs(60));
+    let b = FragmentState::new(HashMap::new(), None, 100, Duration::from_secs(60));
+    let first = ReplicatedOp { key: "key".into(), value: VersionedValue::new(vec![1], 100, "writer".into()), seq: 0, boot_id: 0 };
+    let mut second = first.clone();
+    second.value.value = vec![2];
+    assert_eq!(a.apply(&first).await.unwrap(), ApplyOutcome::Applied);
+    assert_eq!(b.apply(&second).await.unwrap(), ApplyOutcome::Applied);
+    a.apply(&second).await.unwrap();
+    b.apply(&first).await.unwrap();
+    assert_ne!(a.get("key").await, b.get("key").await);
+}
diff --git a/actordb-client/tests/release_audit_probes.rs b/actordb-client/tests/release_audit_probes.rs
new file mode 100644
--- /dev/null
+++ b/actordb-client/tests/release_audit_probes.rs
@@ -0,0 +1,27 @@
+use std::{io, pin::Pin, sync::Arc, task::{Context, Poll}, time::Duration};
+use actordb::client_server::{ClientServer, ClientServerOptions};
+use actordb::node::{Node, NodeConfig};
+use actordb_client::{Client, ClientOptions};
+use tokio::io::{AsyncRead, AsyncWrite, ReadBuf};
+use tokio::net::TcpStream;
+
+struct PendingShutdown(TcpStream);
+impl AsyncRead for PendingShutdown {
+    fn poll_read(mut self: Pin<&mut Self>, cx: &mut Context<'_>, b: &mut ReadBuf<'_>) -> Poll<io::Result<()>> { Pin::new(&mut self.0).poll_read(cx, b) }
+}
+impl AsyncWrite for PendingShutdown {
+    fn poll_write(mut self: Pin<&mut Self>, cx: &mut Context<'_>, b: &[u8]) -> Poll<io::Result<usize>> { Pin::new(&mut self.0).poll_write(cx, b) }
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> { Pin::new(&mut self.0).poll_flush(cx) }
+    fn poll_shutdown(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> { Poll::Pending }
+}
+
+#[tokio::test]
+async fn release_audit_close_exceeds_client_timeout() {
+    let node = Arc::new(Node::start("audit-close".into(), "127.0.0.1:0".parse().unwrap(), NodeConfig::default()).await.unwrap());
+    let mut server = ClientServer::bind(node.clone(), "127.0.0.1:0".parse().unwrap(), ClientServerOptions::default()).await.unwrap();
+    let client = Client::from_stream(PendingShutdown(TcpStream::connect(server.addr()).await.unwrap()), ClientOptions { timeout: Duration::from_secs(1), ..Default::default() }).await.unwrap();
+    tokio::time::pause();
+    assert!(tokio::time::timeout(Duration::from_secs(10), client.close()).await.is_err());
+    server.shutdown().await;
+    node.shutdown().await.unwrap();
+}
