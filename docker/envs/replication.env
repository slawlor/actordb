# Scenario: 3-node replication over the private docker network.
# node-a writes one key; node-b and node-c must converge on it.
A_TEST=replicate-writer --node-id node-a --port 7447 --expect-peers 2 --key docker-key --value docker-value
B_TEST=replicate-reader --node-id node-b --port 7447 --peer node-a:7447 --key docker-key --value docker-value
C_TEST=replicate-reader --node-id node-c --port 7447 --peer node-a:7447 --key docker-key --value docker-value
