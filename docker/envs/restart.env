# Scenario: SIGKILL node-a mid-cluster, restart it, assert reconvergence.
# Driven by docker/restart-test.sh (kill -9 is real, not a graceful exit):
#   node-a writes v1, gets SIGKILLed, reboots, must converge on v2
#   node-b survives, writes v2, watches node-a die and return
#   node-c is a third witness converging on v2
# node-a persists to /tmp/actordb so the SIGKILL also proves RocksDB
# recovery (its pre-kill write must survive on disk, not just via sync).
A_TEST=restart-crashing --node-id node-a --port 7447 --db-path /tmp/actordb --peer node-b:7447 --key docker-key --put-value v1 --expect-value v2 --sentinel /tmp/crashed
B_TEST=restart-survivor --node-id node-b --port 7447 --key docker-key --put-value v1 --expect-value v2
C_TEST=replicate-reader --node-id node-c --port 7447 --peer node-a:7447 --key docker-key --value v2 --timeout-secs 180
